NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Postgres/Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wc_planner

# Redis cache
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace_me

# Flights: Ignav + public airport data
IGNAV_API_KEY=
IGNAV_BASE_URL=https://ignav.com/api
AIRPORTS_DATA_URL=https://raw.githubusercontent.com/mwgg/Airports/master/airports.json

# TheSportsDB
THESPORTSDB_API_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_LEAGUE_ID=4429

# Football-Data.org (recommended for World Cup fixtures in UTC)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Time API
TIME_API_BASE_URL=https://timeapi.bio/api/time/current/zone

# Open-Meteo (no API key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Maps, restaurants and tourist points
# Google Maps Platform requires billing, but can be used within eligible free monthly usage.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# Optional free/freemium tourism providers. Used when their keys are present.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v2
OPENTRIPMAP_API_KEY=
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1/en/places
